# Meetup iCal feed URL
# Get this from your Meetup group page -> Events tab -> Calendar/export -> iCal link
MEETUP_ICAL_URL=https://www.meetup.com/your-group-name/events/ical/

# Meetup group URL (used for links across the site)
MEETUP_GROUP_URL=https://www.meetup.com/your-group-name

# Upstash Redis (for persisting past events automatically)
# Get these from https://console.upstash.com/ -> create a Redis database
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
